# =============================================================================
# CABA AI Document Intelligence — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================


# ---- App 
ENVIRONMENT=local              # local | development | staging | production
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) 
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caba_doc_intelligence
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ---- Redis / Celery ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ---- Security 
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Storage 
# Cloudinary is the temp/quarantine/review/permanent storage layer in ALL
# environments, including local dev — local filesystem is never the temp
# storage path, since it breaks the moment you run more than one API/worker
# process (each would only see files on its own disk).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_TEMP_FOLDER=caba/temp
CLOUDINARY_QUARANTINE_FOLDER=caba/quarantine
CLOUDINARY_REVIEW_FOLDER=caba/review
CLOUDINARY_PERMANENT_FOLDER=caba/permanent

# Local filesystem is ONLY a scratch buffer while a file is being read for
# OCR/extraction before/after the Cloudinary round-trip — never long-term storage.
LOCAL_SCRATCH_PATH=./storage/scratch
MAX_UPLOAD_SIZE_MB=15
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png

# ---- LLM (Groq) ----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3
LLM_TEMPERATURE=0.1

# ---- OCR 
# On Windows, point this at tesseract.exe if it's not on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe


TESSERACT_CMD=      # If Tesseract is available on PATH, so no explicit Windows path is required.

OCR_LANGUAGE=eng
USE_PADDLEOCR=false
